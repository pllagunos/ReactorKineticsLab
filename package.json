{
  "name": "reactor-web-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "backend:install": "cd backend && uv sync",
    "frontend:install": "bun install --cwd ./frontend",
    "dev": "bun run --parallel dev:backend dev:frontend",
    "dev:backend": "cd backend && uv run uvicorn reactor_backend.app:app --reload --app-dir . --host 127.0.0.1 --port 8000",
    "dev:frontend": "bun run --cwd ./frontend dev",
    "build": "bun run --cwd ./frontend build",
    "lint": "bun run --cwd ./frontend lint",
    "preview": "bun run --cwd ./frontend preview"
  }
}
