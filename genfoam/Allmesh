#!/bin/sh
cd ${0%/*} || exit 1

. $WM_PROJECT_DIR/bin/tools/RunFunctions

mesh_file=constant/generated/concentric_reactor_wedge.msh
manifest_file=constant/generated/concentric_reactor_mesh_manifest.json

if [ ! -f "$mesh_file" ] || [ ! -f "$manifest_file" ]; then
    echo "Missing prepared Gmsh mesh or manifest." >&2
    echo "Run prepare_concentric_case.py before Allmesh/Allrun." >&2
    exit 1
fi

rm -rf constant/neutroRegion/polyMesh
runApplication -o gmshToFoam -case . -region neutroRegion "$mesh_file" || exit 1
runApplication -o -s configureMesh conda run -n openmc python gmsh_reactor_mesh.py configure-import --case-dir . --region neutroRegion --manifest-file "$manifest_file" || exit 1
runApplication -o checkMesh -case . -region neutroRegion || exit 1
runApplication -o -s validateMesh conda run -n openmc python gmsh_reactor_mesh.py validate-import --case-dir . --region neutroRegion --manifest-file "$manifest_file" || exit 1
